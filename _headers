# Portable header rules — read by BOTH Cloudflare Pages and Netlify.
# (netlify.toml stays for when Netlify's account is back; the two are kept in
# sync. Cloudflare ignores the toml and reads this file.)
# Pretty URLs and 404.html are automatic on Cloudflare Pages — no _redirects needed.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data:; connect-src 'self' https://*.open-meteo.com https://*.api.radio-browser.info https://public.radio.co https://somafm.com https://kathy.torontocast.com:2005 https://radio.streemlion.com:4405 https://c22.radioboss.fm:18364 https://scream.behindthesch3m3s.com https://podradio.us https://c23.radioboss.fm https://r.bgp.rodeo https://cors.eu.org https://api.live365.com; media-src https:; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=604800

/js/*
  Cache-Control: public, max-age=604800
